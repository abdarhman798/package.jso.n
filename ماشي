            if (obj:IsA("NumberValue") or obj:IsA("IntValue")) and (obj.Name:lower():match("stamina") or obj.Name:lower():match("energy")) then
                obj.Value = 100
            end
        end
        for attrName, attrValue in pairs(char:GetAttributes()) do
            local lowerName = attrName:lower()
