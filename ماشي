-- [ صائد المفترسات ]
local hunterActive = false
local currentTarget = nil
local function getNearestTarget()
    local nearest, maxDist = nil, 300
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                local dist = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                if dist < maxDist then maxDist, nearest = dist, p.Character end
            end
        end
    end
    return nearest
end

createToggle(combatTab, "Predator Hunter | صائد المفترسات", function(state)
    hunterActive = state
    currentTarget = state and getNearestTarget() or nil
end)
RunService.RenderStepped:Connect(function()
    if hunterActive then
        if currentTarget and currentTarget:FindFirstChild("Humanoid") and currentTarget.Humanoid.Health > 0 and currentTarget:FindFirstChild("HumanoidRootPart") then
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then myHrp.CFrame = currentTarget.HumanoidRootPart.CFrame * CFrame.new(0, 0.5, 2.5) end
        else
            currentTarget = getNearestTarget()
        end
    end
end)

