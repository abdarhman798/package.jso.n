local function getAnimalInfo(character)
    local animalName = character:GetAttribute("AnimalName")
    local charName = character:GetAttribute("CharacterName")

    if animalName then
        local safeName = string.lower(string.gsub(animalName, "%s+", ""))
        if animalData[safeName] then return animalData[safeName] end
    end
    if charName == "StarterCharacter2" then return animalData["wilddog"] end
    return {color = Color3.fromRGB(255, 0, 0), name = "حيوان مجهول"} 
end

local function clearESP(player)
    if espObjects[player] then
        if espObjects[player].Highlight then espObjects[player].Highlight:Destroy() end
        if espObjects[player].Billboard then espObjects[player].Billboard:Destroy() end
        espObjects[player] = nil
    end
end

createToggle(visualTab, "Animal ESP | كشف الحيوانات", function(state)
    espActive = state
    if not espActive then
        for player, _ in pairs(espObjects) do clearESP(player) end
    end
end)

RunService.RenderStepped:Connect(function()
    if espActive then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChild("Humanoid")
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                if char and hrp and humanoid and humanoid.Health > 0 and myHrp then
                    local info = getAnimalInfo(char)
                    local distance = math.floor((hrp.Position - myHrp.Position).Magnitude) 
                    
                    if not espObjects[player] or not espObjects[player].Highlight.Parent or espObjects[player].Highlight.Parent ~= char then
                        clearESP(player) 
                        
                        local hl = Instance.new("Highlight")
                        hl.Name = "ABDESP_HL"
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = char
                        
                        local bg = Instance.new("BillboardGui")
                        bg.Name = "ABDESP_BG"
                        bg.Size = UDim2.new(0, 200, 0, 40)
                        bg.StudsOffset = Vector3.new(0, 3, 0) 
                        bg.AlwaysOnTop = true
                        bg.Parent = char
                        
                        local txt = Instance.new("TextLabel")
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Font = Enum.Font.GothamBold
                        txt.TextSize = 14
                        txt.TextStrokeTransparency = 0 
                        txt.Parent = bg
                        
                        espObjects[player] = { Highlight = hl, Billboard = bg, Text = txt }
                    end
                    
                    local objs = espObjects[player]
                    objs.Highlight.FillColor = info.color
                    objs.Text.Text = info.name .. " | " .. distance .. "m"
                    objs.Text.TextColor3 = info.color
                else
                    clearESP(player)
                end
            end
        end
    end
