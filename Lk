local function SetupChatArea(parentArea, isGroup)
    if isGroup then
        local GLabel = Instance.new("TextLabel", parentArea)
        GLabel.Size = UDim2.new(1, 0, 0, 25); GLabel.BackgroundTransparency = 1; GLabel.Text = "لست في مجموعة"
        GLabel.TextColor3 = Color3.fromRGB(150, 150, 150); GLabel.Font = SafeFont; GLabel.TextSize = 12; GLabel.Name = "GroupStatus"
    end
    local Scroll = Instance.new("ScrollingFrame", parentArea)
    Scroll.Size = UDim2.new(1, -20, 1, isGroup and -75 or -50); Scroll.Position = UDim2.new(0, 10, 0, isGroup and 25 or 5)
    Scroll.BackgroundTransparency = 1; Scroll.ScrollBarThickness = 2; Scroll.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100); Scroll.Name = "ChatScroll"
    local Layout = Instance.new("UIListLayout", Scroll); Layout.Padding = UDim.new(0, 5)
    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10) end)

    local InputHolder = Instance.new("Frame", parentArea)
    InputHolder.Size = UDim2.new(1, -20, 0, 35); InputHolder.Position = UDim2.new(0, 10, 1, -40); InputHolder.BackgroundTransparency = 1

    local Input = Instance.new("TextBox", InputHolder)
    Input.Size = UDim2.new(1, -40, 1, 0); Input.Position = UDim2.new(0, 0, 0, 0); Input.BackgroundColor3 = Color3.fromRGB(25, 27, 33)
    Input.TextColor3 = Color3.new(1, 1, 1); Input.Text = ""; Input.PlaceholderText = isGroup and "رسالة مجموعة..." or "رسالة عامة..."
    Input.Font = SafeFont; Input.TextSize = 13; Input.TextXAlignment = Enum.TextXAlignment.Left; Input.Name = "InputBox"; Input.ClearTextOnFocus = false
    Instance.new("UIPadding", Input).PaddingLeft = UDim.new(0, 10); Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 8)

    local StkBtn = Instance.new("TextButton", InputHolder)
    StkBtn.Size = UDim2.new(0, 35, 1, 0); StkBtn.Position = UDim2.new(1, -35, 0, 0); StkBtn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
    StkBtn.TextColor3 = Color3.new(1, 1, 1); StkBtn.Font = SafeFont; StkBtn.TextSize = 16; StkBtn.Text = "🖼️"; StkBtn.Name = "StickerBtn"
    Instance.new("UICorner", StkBtn).CornerRadius = UDim.new(0, 8)

    return Scroll, Input, StkBtn
end

