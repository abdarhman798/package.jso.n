    if t == "lon3/" then NameColorType = 3; return true end
    if t == "شيل لون/" then NameColorType = 0; return true end
    
    if t == "klp/" then 
        if IsDeveloper or GlobalAdmins[LP.Name] then FireServerMessage("/sys_klp") end
        return true
    end
    if t == "pop/" then
        FireServerMessage("/sys_pop")
        return true
    end
    
    if t == "سطر1/" then ZombieFont = true; return true end
    
    if t:sub(1, 6) == "name/ " then 
        local n = t:sub(7)
        if n ~= "" then CustomName = n end
        return true 
    elseif t:sub(1, 5) == "name/" then 
        local n = t:sub(6)
        if n ~= "" then CustomName = n end 
        return true 
    end
    
    if t == "بوت400/" then FireServerMessage("/sys_nuke"); return true end
    return false
end

local function HandleIncomingMessage(data)
    local name = data.sender
    local realName = data.realName or name
    local text = data.content
    
    local senderJobId = data.jobId or ""
    local isSenderStaff = (data.isDev or data.isAdmin or realName == "ABD777HH")
    local iAmStaff = (IsDeveloper or GlobalAdmins[LP.Name] ~= nil)
    
    if senderJobId ~= "" and senderJobId ~= game.JobId then
        if not (iAmStaff or isSenderStaff) then return end
    end
    
    if text:find(secretTag) then
        local clean = text:gsub(secretTag, "")
        local parts = clean:split("|")
        local cmd = parts[1]

        if GlobalBans[realName] and cmd ~= "/sys_gban" and cmd ~= "/sys_unban" then return end

        if cmd == "/sys_giveadmin" and (realName == "ABD777HH" or isSenderStaff) then
            GlobalAdmins[parts[2]] = true
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "✅ تم ترقية [" .. parts[2] .. "] إلى رتبة أدمن.", Color3.fromRGB(52, 152, 219))
            return
        end
        
        -- [ إضافة أمر سحب الأدمن ليراه الجميع ]
        if cmd == "/sys_removeadmin" and (realName == "ABD777HH" or isSenderStaff) then
            GlobalAdmins[parts[2]] = nil
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "❌ تم سحب رتبة الأدمن من [" .. parts[2] .. "].", Color3.fromRGB(231, 76, 60))
            return
        end

        if cmd == "/sys_klp" then
            if data.jobId == game.JobId and realName ~= LP.Name and not IsDeveloper then
                if isSenderStaff then LP:Kick("تم تحديث سكربت فوت سيرفر مره ثانيه ABD HUB") end
            end
            return
        end
        
        if cmd == "/sys_pop" then
            task.spawn(function()
                local originalColor = MainStroke.Color
                local originalTitleColor = TitleLabel.TextColor3
                for i = 1, 25 do
                    TS:Create(MainStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(255, math.random(50, 150), 0)}):Play()
                    TS:Create(TitleLabel, TweenInfo.new(0.1), {TextColor3 = Color3.fromRGB(255, math.random(50, 150), 0)}):Play()
                    task.wait(0.2)
                end
                TS:Create(MainStroke, TweenInfo.new(0.5), {Color = originalColor}):Play()
                TS:Create(TitleLabel, TweenInfo.new(0.5), {TextColor3 = originalTitleColor}):Play()
            end)
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "🔥 الشات ولع نار! 🔥", Color3.fromRGB(255, 85, 0))
            return
        end

        if cmd == "/sys_gkick" then
            if parts[2] == LP.Name then LP:Kick("تم طردك من السيرفر. (بناءً على قانون P)") end
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "👢 تم طرد [" .. parts[2] .. "].", Color3.fromRGB(231, 76, 60))
            return
        elseif cmd == "/sys_gban" then
            GlobalBans[parts[2]] = true
            if parts[2] == LP.Name then LP:Kick("لقد تم حظرك نهائياً من السكربت. (بناءً على قانون P)") end
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "🚫 تم حظر [" .. parts[2] .. "] نهائياً.", Color3.fromRGB(192, 57, 43))
            return
        elseif cmd == "/sys_unban" then
            GlobalBans[parts[2]] = nil
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "✅ تم فك الحظر عن [" .. parts[2] .. "].", Color3.fromRGB(46, 204, 113))
            return
        elseif cmd == "/sys_gmute" then
            local dur = tonumber(parts[3]) or 999999999
            GlobalMutes[parts[2]] = os.time() + dur
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "🔇 تم كتم [" .. parts[2] .. "].", Color3.fromRGB(241, 196, 15))
            return
        elseif cmd == "/sys_unmute" then
            GlobalMutes[parts[2]] = nil
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "🔊 تم فك الميوت عن [" .. parts[2] .. "].", Color3.fromRGB(46, 204, 113))
            return
        end

        if GlobalMutes[realName] and os.time() < GlobalMutes[realName] and (cmd == "/sys_msg" or cmd == "/stk" or cmd == "/sys_pm" or cmd == "/sys_grp" or cmd == "/sys_grpstk") then return end

        if cmd == "/sys_edit" then
            local editId = parts[2]; local newTxt = parts[3]
            if ActiveMessages[editId] then
                local am = ActiveMessages[editId]; am.RawText = newTxt
                local displayText = newTxt; if data.z then displayText = '<font face="Creepster">' .. displayText .. '</font>' end
                -- إضافة LRM لرسائل التعديل أيضاً
                am.Label.Text = "[" .. am.Prefix .. "]\226\128\142: " .. displayText
            end
            return
        end

        if cmd == "/sys_nuke" then
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                char.HumanoidRootPart.Velocity = Vector3.new(0, 1500, 0)
                local exp = Instance.new("Explosion"); exp.Position = char.HumanoidRootPart.Position; exp.Parent = workspace
                task.wait(0.5); char.Humanoid.Health = 0
            end
            return
        end

        if cmd == "/stk" and realName ~= LP.Name then
            local stkId = parts[2]
            AddMessageToUI(GenScroll, name, realName, stkId, nil, false, nil, data.nc, data.z, true)
            ShowBottomPopup("شات عام", name, "أرسل ملصق 🖼️")
            local char = game.Players:FindFirstChild(realName) and game.Players[realName].Character
            if char then CreateCustomBubble(char, stkId, data.z, true) end
            
        elseif cmd == "/sys_grpstk" and parts[2] == GroupState.Name and realName ~= LP.Name then
            local stkId = parts[3]
            AddMessageToUI(GrpScroll, name, realName, stkId, Color3.fromRGB(52, 152, 219), true, nil, data.nc, data.z, true)
            ShowBottomPopup(GroupState.Name, name, "أرسل ملصق 🖼️")
            local char = game.Players:FindFirstChild(realName) and game.Players[realName].Character
            if char then CreateCustomBubble(char, stkId, data.z, true) end

        elseif cmd == "/sys_hello" and realName ~= LP.Name then
            ActiveUsers[realName] = true; UpdateRadarUI()
            local myStatus = GroupState.Active and "ingroup" or "free"
            FireServerMessage("/sys_pong|" .. myStatus)
            
        elseif cmd == "/sys_join" and realName ~= LP.Name then
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "🔔 [" .. name .. "] انضم للشات!", Color3.fromRGB(46, 204, 113))
            if IsDeveloper then for banned, _ in pairs(GlobalBans) do FireServerMessage("/sys_gban|" .. banned) end end
            
        elseif cmd == "/sys_quit" and realName ~= LP.Name then
            ActiveUsers[realName] = nil; PlayersInGroups[realName] = nil; UpdateRadarUI()
            AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "🔴 [" .. name .. "] غادر.", Color3.fromRGB(231, 76, 60))
            if GroupState.Active and GroupState.Members[realName] then GroupState.Members[realName] = nil; GroupState.Admins[realName] = nil; UpdateGroupManageUI() end

        elseif cmd == "/sys_ping" and realName ~= LP.Name then
            local myStatus = GroupState.Active and "ingroup" or "free"; FireServerMessage("/sys_pong|" .. myStatus)
            
        elseif cmd == "/sys_pong" and realName ~= LP.Name then
            ActiveUsers[realName] = true; if parts[2] == "ingroup" then PlayersInGroups[realName] = true end; UpdateRadarUI()
            
        elseif cmd == "/sys_pm" and parts[2] == LP.Name then
            PlaySound("rbxassetid://2865227271", 2) 
            if parts[3] == "/stk" then
                AddMessageToUI(GenScroll, name, realName, parts[4], Color3.fromRGB(155, 89, 182), false, data.msgId, data.nc, data.z, true)
                ShowBottomPopup("رسالة خاصة 🔒", name, "أرسل ملصق 🖼️")
                local char = game.Players:FindFirstChild(realName) and game.Players[realName].Character
                if char then CreateCustomBubble(char, parts[4], data.z, true) end
            else
                AddMessageToUI(GenScroll, name, realName, "🔒 [همس]: " .. parts[3], Color3.fromRGB(155, 89, 182), false, data.msgId, data.nc, data.z)
                ShowBottomPopup("رسالة خاصة 🔒", name, parts[3])
                local char = game.Players:FindFirstChild(realName) and game.Players[realName].Character
                if char then CreateCustomBubble(char, "🔒 " .. parts[3], data.z, false) end
            end

        elseif cmd == "/sys_ingroup" and realName ~= LP.Name then
            PlayersInGroups[realName] = true; UpdateRadarUI()

        elseif cmd == "/sys_syncgrp" then
            local jsonStr = string.sub(clean, string.len(cmd) + 2)
            local s, parsed = pcall(function() return HttpService:JSONDecode(jsonStr) end)
            if s and parsed and parsed.Name == GroupState.Name then GroupState = parsed; UpdateGroupManageUI() end
            
        elseif cmd == "/sys_newowner" and parts[2] == GroupState.Name then
            GroupState.Owner = parts[3]; GroupState.Admins[parts[3]] = nil
            if parts[3] == LP.Name then AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "👑 أصبحت مالك المجموعة!", Color3.fromRGB(241, 196, 15)) else AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "👑 [" .. parts[3] .. "] هو المالك الجديد.", Color3.fromRGB(241, 196, 15)) end
            UpdateGroupManageUI()

        elseif cmd == "/sys_reqkick" and GroupState.Owner == LP.Name then
            local target = parts[2]
            if GroupState.Admins[realName] and target ~= LP.Name and not GroupState.Admins[target] then
                GroupState.Members[target] = nil; GroupState.Admins[target] = nil; if GroupState.Mutes then GroupState.Mutes[target] = nil end
                BroadcastGroupState(); FireServerMessage("/sys_kickgrp|" .. target)
                AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "[" .. target .. "] تم طرده من قبل [" .. name .. "]", Color3.fromRGB(231, 76, 60))
            end

        elseif cmd == "/sys_reqmute" and GroupState.Owner == LP.Name then
            local target = parts[2]; local dur = tonumber(parts[3]) or 0
            if GroupState.Admins[realName] and target ~= LP.Name and not GroupState.Admins[target] then
                GroupState.Mutes = GroupState.Mutes or {}; GroupState.Mutes[target] = os.time() + dur; BroadcastGroupState()
                AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "[" .. target .. "] تم كتمه من قبل [" .. name .. "]", Color3.fromRGB(241, 196, 15))
            end

        elseif cmd == "/sys_kickgrp" and parts[2] == LP.Name then
            GroupState = { Active = false, Name = "", Owner = "", Admins = {}, Members = {}, Mutes = {} }
            TabGroup.Visible = false; SwitchTab("General"); ClearGroupChat(); AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "❌ تم طردك من المجموعة!", Color3.fromRGB(231, 76, 60)); UpdateGroupManageUI()

        elseif cmd == "/sys_acc" and parts[2] == GroupState.Name and GroupState.Owner == LP.Name then
            GroupState.Members[realName] = os.time(); BroadcastGroupState(); AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "✅ [" .. name .. "] انضم للمجموعة!", Color3.fromRGB(46, 204, 113))

        elseif cmd == "/sys_leave" and parts[2] == GroupState.Name and GroupState.Owner == LP.Name then
            GroupState.Members[realName] = nil; GroupState.Admins[realName] = nil; BroadcastGroupState()
            AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "🚪 [" .. name .. "] غادر المجموعة.", Color3.fromRGB(231, 76, 60))

        elseif cmd == "/sys_disband" and parts[2] == GroupState.Name and realName ~= LP.Name then
            GroupState = { Active = false, Name = "", Owner = "", Admins = {}, Members = {}, Mutes = {} }
            TabGroup.Visible = false; SwitchTab("General"); ClearGroupChat(); AddMessageToUI(GenScroll, "SYSTEM", "SYSTEM", "⚠️ تم حل المجموعة.", Color3.fromRGB(231, 76, 60)); UpdateGroupManageUI()

        elseif cmd == "/sys_inv" and parts[2] == LP.Name then
            if GroupState.Active or IgnoreInvites then FireServerMessage("/sys_busy|" .. realName); return end 
            local gName = parts[3]; PlaySound("rbxassetid://2865227271", 2); InvMsgLabel.Text = "[" .. name .. "] دعاك لـ:\n[" .. gName .. "]"; InviteDialog.Visible = true
            
            AccBtn.MouseButton1Click:Connect(function()
                GroupState = { Active = true, Name = gName, Owner = realName, Admins = {}, Members = {[LP.Name]=os.time(), [realName]=os.time()}, Mutes = {} }
                GroupArea.GroupStatus.Text = "المجموعة: " .. gName; TabGroup.Visible = true; SwitchTab("Group"); InviteDialog.Visible = false
                ClearGroupChat(); AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "انضممت للمجموعة!", Color3.fromRGB(46, 204, 113))
                FireServerMessage("/sys_ingroup"); FireServerMessage("/sys_acc|" .. gName); UpdateGroupManageUI()
            end)
            DecBtn.MouseButton1Click:Connect(function() InviteDialog.Visible = false end)
            
        elseif cmd == "/sys_busy" and parts[2] == LP.Name then
            AddMessageToUI(GrpScroll, "SYSTEM", "SYSTEM", "⚠️ [" .. name .. "] مشغول p.", Color3.fromRGB(241, 196, 15))

        elseif cmd == "/sys_grp" and parts[2] == GroupState.Name and realName ~= LP.Name then
            AddMessageToUI(GrpScroll, name, realName, parts[3], Color3.fromRGB(52, 152, 219), true, data.msgId, data.nc, data.z)
            ShowBottomPopup(GroupState.Name, name, parts[3])
            local char = game.Players:FindFirstChild(realName) and game.Players[realName].Character
            if char then CreateCustomBubble(char, parts[3], data.z, false) end

        elseif cmd == "/sys_msg" and realName ~= LP.Name then
            AddMessageToUI(GenScroll, name, realName, parts[2], nil, false, data.msgId, data.nc, data.z)
            ShowBottomPopup("شات عام", name, parts[2])
            local char = game.Players:FindFirstChild(realName) and game.Players[realName].Character
            if char then CreateCustomBubble(char, parts[2], data.z, false) end
        end
    end
end

